# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database (MySQL) — pilih salah satu:
# Opsi A (disarankan lokal, dipakai drizzle.config.ts + fallback db/index.ts):
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aristoteles
# Opsi B (satu string, dipakai prioritas oleh db/index.ts bila diisi):
# DATABASE_URL=mysql://root:@localhost:3306/aristoteles

# JWT (wajib, minimal 32 karakter acak; tanpa ini server menolak start saat auth dipakai)
JWT_SECRET=ganti-dengan-minimal-32-karakter-acak-di-production
# Masa berlaku access token. Default kode: 15m bila kosong.
JWT_EXPIRES_IN=15m
# Catatan Tahap 1: tidak ada refresh token. Jangan tambahkan
# JWT_REFRESH_* sebelum backend benar-benar mendukung alur refresh.

# CORS (origin frontend dev SvelteKit)
CORS_ORIGIN=http://localhost:5173
