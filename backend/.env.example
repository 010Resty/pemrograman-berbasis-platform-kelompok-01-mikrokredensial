# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database (MySQL) — pilih salah satu:
# Opsi A (disarankan lokal, dipakai drizzle.config.ts + fallback db/index.ts):
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aristoteles
# Opsi B (satu string, dipakai prioritas oleh db/index.ts bila diisi):
# DATABASE_URL=mysql://root:@localhost:3306/aristoteles

# JWT (wajib, minimal 32 karakter acak; tanpa ini server menolak start saat auth dipakai)
JWT_SECRET=ganti-dengan-minimal-32-karakter-acak-di-production
# Masa berlaku access token. Default kode: 15m bila kosong.
JWT_EXPIRES_IN=15m
# Refresh token opaque sekali pakai untuk klien mobile (rotasi tiap pakai).
# Umur hari; default kode: 30 bila kosong.
REFRESH_EXPIRES_DAYS=30

# CORS (origin frontend dev SvelteKit)
CORS_ORIGIN=http://localhost:5173

# Email via Nodemailer SMTP (OTP verifikasi + reset password + undangan instruktur)
# MAIL_PROVIDER: smtp | log (default otomatis: smtp bila SMTP_HOST terisi,
# selain itu log ke console untuk dev)
MAIL_PROVIDER=log
# Alamat pengirim, mis. "ARISTOTELES <noreply@domain-anda.id>".
# Untuk Gmail, samakan dengan SMTP_USER agar tidak ditolak.
# Bila kosong, dipakai SMTP_USER.
MAIL_FROM=
# SMTP Nodemailer (wajib untuk kirim email asli).
# Pasangan port/secure yang benar (salah pasang = error saat kirim):
# - smtp.gmail.com:587 + SECURE=false (STARTTLS, disarankan)
# - smtp.gmail.com:465 + SECURE=true  (implicit TLS)
# Gmail WAJIB App Password, bukan password login:
# 1. Aktifkan 2-Step Verification (Google Account → Keamanan).
# 2. Buat App Password (Keamanan → App passwords) → 16 huruf.
# 3. Isi 16 huruf itu ke SMTP_PASS (spasi otomatis diabaikan).
# Contoh:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=email.anda@gmail.com
# SMTP_PASS=abcdabcdabcdabcd
# SMTP_SECURE=false
# Tautan undangan menunjuk frontend SvelteKit (dipakai /invite/<token> di email).
# WAJIB diganti domain publik saat production (mis. https://domain-anda.id);
# server production menolak start bila ini kosong (tautan salah domain).
FRONTEND_URL=http://localhost:5173
# OTP: kedaluwarsa menit, cooldown kirim ulang detik, maks percobaan salah
OTP_EXPIRES_MIN=10
OTP_RESEND_COOLDOWN_SEC=60
OTP_MAX_ATTEMPTS=5
# Rate limit pengajuan publik (default 10x per 15 menit per IP)
# SUBMIT_RATE_LIMIT_MAX=10
# SUBMIT_RATE_LIMIT_WINDOW_MS=900000
