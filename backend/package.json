{
  "name": "aristoteles-backend",
  "version": "1.0.0",
  "description": "Backend for ARISTOTELES microcredential platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsx --test src/modules/auth/__tests__/email-verification.test.ts src/modules/auth/__tests__/refresh-token.test.ts src/modules/patungan/__tests__/patungan-rules.test.ts src/middlewares/__tests__/rate-limit.test.ts src/modules/applications/__tests__/application.test.ts src/modules/applications/__tests__/application-api.test.ts src/utils/__tests__/mailer.test.ts src/modules/invitations/__tests__/invitation-reissue.test.ts src/modules/courses/__tests__/material-pass-score.test.ts src/modules/courses/__tests__/material-progress-kept.test.ts src/modules/courses/__tests__/tiptap-xss.test.ts src/modules/progress/__tests__/progress.test.ts src/modules/progress/__tests__/progress-summary.test.ts src/modules/quiz/__tests__/quiz.test.ts src/modules/enrollments/__tests__/enrollments.test.ts src/modules/submissions/__tests__/submissions.test.ts src/modules/certificates/__tests__/certificates.test.ts src/modules/certificates/__tests__/certificate-autoissue.test.ts src/modules/vouchers/__tests__/voucher-admin.test.ts src/modules/payments/__tests__/payment-rules.test.ts src/modules/payments/__tests__/payment-verify.test.ts src/modules/promos/__tests__/promo.test.ts src/modules/patungan/__tests__/patungan.test.ts src/modules/dashboard/__tests__/dashboard.test.ts src/modules/admin/__tests__/admin-overview.test.ts src/modules/admin/__tests__/admin-update-user.test.ts src/modules/uploads/__tests__/upload-role.test.ts",
    "mail:check": "tsx src/utils/check-mail.ts",
    "db:generate": "drizzle-kit generate:mysql",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push:mysql",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": [
    "microcredential",
    "express",
    "typescript",
    "drizzle-orm",
    "mysql"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.29.0",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.6.5",
    "nodemailer": "^10.3.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.20.9",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
