{
  "contractVersion": "1.0.0",
  "backendPrefix": "/api/v1",
  "note": "Mirror ringkas backend/docs/API_CONTRACT.md untuk kebutuhan aplikasi web + Android. Bila berbeda dengan perilaku backend, backend yang menang.",
  "auth": "Authorization: Bearer <JWT 15m>",
  "endpoints": [
    { "id": "auth.register", "method": "POST", "path": "/auth/register", "access": "public", "body": "{name, username, email, password}", "success": "201 OTP terkirim (akun BELUM dibuat; peran selalu student K-01)" },
    { "id": "auth.verify-email", "method": "POST", "path": "/auth/verify-email", "access": "public", "body": "{email, code 6 digit}", "success": "201 {accessToken, refreshToken, user}" },
    { "id": "auth.resend", "method": "POST", "path": "/auth/resend-verification", "access": "public", "body": "{email}", "success": "200" },
    { "id": "auth.forgot", "method": "POST", "path": "/auth/forgot-password", "access": "public", "body": "{email}", "success": "200 generik (anti-enumerasi)" },
    { "id": "auth.verify-reset", "method": "POST", "path": "/auth/verify-reset-code", "access": "public", "body": "{email, code}", "success": "200" },
    { "id": "auth.reset", "method": "POST", "path": "/auth/reset-password", "access": "public", "body": "{email, code, newPassword}", "success": "200 (wajib login ulang)" },
    { "id": "auth.login", "method": "POST", "path": "/auth/login", "access": "public", "body": "{email, password}", "success": "200 {accessToken, refreshToken, user}" },
    { "id": "auth.refresh", "method": "POST", "path": "/auth/refresh", "access": "public", "body": "{refreshToken}", "success": "200 pasangan baru; token lama hangus; pakai ulang = 401 + cabut semua sesi" },
    { "id": "auth.logout", "method": "POST", "path": "/auth/logout", "access": "user", "body": "{refreshToken?} tanpa = cabut semua sesi", "success": "200 {revoked}" },
    { "id": "auth.me", "method": "GET", "path": "/auth/me", "access": "user", "success": "200 {user} (Cache-Control: no-store)" },
    { "id": "profile.get", "method": "GET", "path": "/me/profile", "access": "user", "success": "200 profil penuh" },
    { "id": "profile.patch", "method": "PATCH", "path": "/me/profile", "access": "user", "body": "parsial {name, username, phone, gender, birthPlace, birthDate, avatarFileId, coverFileId}; email/role ditolak", "success": "200" },
    { "id": "profile.unavatar", "method": "DELETE", "path": "/me/profile/avatar", "access": "user", "success": "200" },
    { "id": "catalog.list", "method": "GET", "path": "/courses", "access": "public", "success": "200 array published+archived (draft tidak bocor)" },
    { "id": "catalog.detail", "method": "GET", "path": "/courses/:id", "access": "public", "success": "200 detail + instructors[]; draft 404 bagi asing" },
    { "id": "course.create", "method": "POST", "path": "/courses", "access": "teacher", "body": "selalu status draft", "success": "201" },
    { "id": "course.patch", "method": "PATCH", "path": "/courses/:id", "access": "manager", "success": "200" },
    { "id": "course.delete", "method": "DELETE", "path": "/courses/:id", "access": "manager", "success": "200" },
    { "id": "course.tree-modules", "method": "GET", "path": "/courses/:courseId/modules", "access": "public", "success": "200; isi materi = null bila tanpa hak akses" },
    { "id": "course.tree-detail", "method": "GET", "path": "/materials/:id", "access": "user", "success": "200 penuh bila berhak; anon 401, tanpa akses 403 NO_ACCESS" },
    { "id": "curriculum.create-module", "method": "POST", "path": "/courses/:courseId/modules", "access": "manager", "success": "201" },
    { "id": "curriculum.patch-material", "method": "PATCH", "path": "/materials/:id", "access": "manager", "body": "parsial + expectedUpdatedAt? + changeSignificance? + changeReason?", "success": "200; 409 MATERIAL_CONFLICT bila berubah sejak dibuka" },
    { "id": "curriculum.material-changes", "method": "GET", "path": "/materials/:id/changes", "access": "manager", "success": "200 riwayat resmi dari audit (K-08)" },
    { "id": "enroll.free", "method": "POST", "path": "/courses/:id/enroll", "access": "user", "success": "201 aktif; berbayar 403 NEEDS_MANUAL_GRANT" },
    { "id": "enroll.access", "method": "GET", "path": "/courses/:id/access", "access": "user", "success": "200 {hasAccess, isManager, enrollment}" },
    { "id": "enroll.mine", "method": "GET", "path": "/me/enrollments", "access": "user", "success": "200 array milik sendiri" },
    { "id": "progress.mark", "method": "POST", "path": "/materials/:id/progress", "access": "user", "success": "200 {completed, alreadyCompleted, certificateIssued}; memicu auto-sertifikat" },
    { "id": "progress.unmark", "method": "DELETE", "path": "/materials/:id/progress", "access": "user", "success": "200" },
    { "id": "progress.mine", "method": "GET", "path": "/me/progress?courseId=", "access": "user", "success": "200 number[] milik sendiri" },
    { "id": "progress.summary", "method": "GET", "path": "/me/progress/summary", "access": "user", "success": "200 persen 1 desimal + perCourse" },
    { "id": "quiz.save-bank", "method": "PUT", "path": "/materials/:id/quiz", "access": "manager", "success": "200 bank baru (ganti atomik)" },
    { "id": "quiz.get", "method": "GET", "path": "/materials/:id/quiz", "access": "user", "success": "200 soal TANPA kunci/penjelasan" },
    { "id": "quiz.attempt", "method": "POST", "path": "/materials/:id/quiz-attempts", "access": "user", "body": "{answers}", "success": "201 penilaian 100% server; lulus menempel" },
    { "id": "quiz.history", "method": "GET", "path": "/materials/:id/quiz-attempts", "access": "user", "success": "200 riwayat milik sendiri" },
    { "id": "quiz.best", "method": "GET", "path": "/materials/:id/quiz-best", "access": "user", "success": "200 {attempts, bestScore, effectivePassScore, passed}" },
    { "id": "task.submit", "method": "POST", "path": "/materials/:id/submissions", "access": "user", "body": "{fileId, studentNim?, note?} resubmit = baris baru", "success": "201" },
    { "id": "task.status", "method": "GET", "path": "/materials/:id/submissions/status", "access": "user", "success": "200 {attempts, graded, passed, lastStatus, bestScore}" },
    { "id": "task.list", "method": "GET", "path": "/materials/:id/submissions", "access": "user", "success": "200 {manager, rows}" },
    { "id": "task.grade", "method": "POST", "path": "/materials/:id/submissions/:subId/grade", "access": "manager", "body": "{score|rubric{kelengkapan,ketepatan,kerapian}, decision, feedback?}", "success": "200; rubrik dihitung server" },
    { "id": "task.queue", "method": "GET", "path": "/instructor/review-queue", "access": "teacher", "success": "200 agregat antrean kelola" },
    { "id": "pay.create", "method": "POST", "path": "/courses/:id/payments", "access": "user", "body": "{proofFileId?, voucherCode?, patunganGroupId?} idempoten per antrean menunggu", "success": "201" },
    { "id": "pay.proof", "method": "PATCH", "path": "/payments/:id/proof", "access": "user", "body": "{proofFileId}", "success": "200" },
    { "id": "pay.my-one", "method": "GET", "path": "/me/payments?courseId=", "access": "user", "success": "200 antrean terakhir / null (polling)" },
    { "id": "pay.my-list", "method": "GET", "path": "/me/payments?status=&limit=&page=", "access": "user", "success": "200 {items,total} (bell peserta)" },
    { "id": "pay.admin-list", "method": "GET", "path": "/admin/payments", "access": "admin", "success": "200 {items,total}" },
    { "id": "pay.verify", "method": "POST", "path": "/admin/payments/:id/verify", "access": "admin", "body": "{decision: terima|tolak, amountPaid?, reason?}", "success": "200 terima = grant + hanguskan voucher; tolak wajib alasan" },
    { "id": "voucher.redeem", "method": "POST", "path": "/vouchers/redeem", "access": "user", "body": "{code, courseId?} anti-race", "success": "201 enrollment akses" },
    { "id": "voucher.validate", "method": "POST", "path": "/vouchers/validate", "access": "user", "body": "{code, courseId} tanpa hanguskan", "success": "200 {discountType, discountValue, discountAmount}" },
    { "id": "voucher.admin", "method": "POST|GET|DISABLE|ENABLE", "path": "/admin/vouchers*", "access": "admin", "success": "kelola + riwayat penukaran" },
    { "id": "cert.issue", "method": "POST", "path": "/modules/:id/certificate", "access": "user", "success": "201 baru / 200 idempoten; 403 NOT_ELIGIBLE; 409 pasca-revoke" },
    { "id": "cert.mine", "method": "GET", "path": "/me/certificates", "access": "user", "success": "200 (tanpa superseded)" },
    { "id": "cert.download", "method": "GET", "path": "/me/certificates/:id/download", "access": "user", "success": "200 PDF; 403 revoked; 410 superseded" },
    { "id": "cert.mystatus", "method": "GET", "path": "/me/modules/:id/certificate-status", "access": "user", "success": "200 {eligible, requirements, failReasons, certificate?}" },
    { "id": "cert.verify", "method": "GET", "path": "/certificates/verify/:code", "access": "public", "success": "200 minimal tanpa PII; 404 CODE_NOT_FOUND" },
    { "id": "cert.verify-qr", "method": "GET", "path": "/certificates/verify/:code/qr", "access": "public", "success": "200 image/png" },
    { "id": "cert.inst-summary", "method": "GET", "path": "/instructor/certificates/summary", "access": "teacher", "success": "200 agregat scope kelola" },
    { "id": "cert.inst-eligibility", "method": "GET", "path": "/instructor/eligibility", "access": "teacher", "success": "200 {items,total}" },
    { "id": "cert.inst-list", "method": "GET", "path": "/instructor/certificates", "access": "teacher", "success": "200 {items,total} incl. dicabut/digantikan" },
    { "id": "cert.inst-detail", "method": "GET", "path": "/instructor/certificates/:id", "access": "teacher", "success": "200" },
    { "id": "cert.revoke", "method": "POST", "path": "/instructor/certificates/:id/revoke", "access": "teacher", "body": "{reason >= 5 char}", "success": "200; ganda 409" },
    { "id": "upload.file", "method": "POST", "path": "/uploads", "access": "user", "body": "{filename, mimeType, kind, data base64} magic-bytes; kind menentukan peran", "success": "201 {id,url}" },
    { "id": "upload.serve", "method": "GET", "path": "/files/:id/content", "access": "mixed", "success": "aset kursus publik; assignment privat (pemilik/pengampu/admin)" },
    { "id": "promo.public", "method": "GET", "path": "/promos|/promos/course/:id|/promos/:slug", "access": "public", "success": "200 hanya active + published" },
    { "id": "promo.admin", "method": "POST|GET|PATCH|...", "path": "/admin/promos*", "access": "admin", "success": "kelola kampanye diskon percent-only" },
    { "id": "patungan.validate", "method": "POST", "path": "/patungan/members/validate", "access": "user", "success": "200 {ready, members, shares} selalu 200 (live-check)" },
    { "id": "patungan.create", "method": "POST", "path": "/patungan/groups", "access": "user", "success": "201 grup pending + audit" },
    { "id": "patungan.mine", "method": "GET", "path": "/patungan/groups/mine", "access": "user", "success": "200" },
    { "id": "patungan.detail", "method": "GET", "path": "/patungan/groups/:id", "access": "user", "success": "200 anggota/admin saja" },
    { "id": "patungan.cancel", "method": "POST", "path": "/patungan/groups/:id/cancel", "access": "user", "success": "200 hanya bila semua unpaid" },
    { "id": "dashboard.teacher", "method": "GET", "path": "/instructor/dashboard/", "access": "teacher", "success": "200 agregat kelola" },
    { "id": "admin.overview", "method": "GET", "path": "/admin/overview", "access": "admin", "success": "200 {totalStudents,totalTeachers,totalCourses,totalCertificates}" },
    { "id": "admin.users", "method": "GET|POST|PATCH", "path": "/admin/users*", "access": "admin", "success": "kelola tanpa passwordHash; role baru dikunci teacher" },
    { "id": "admin.assign", "method": "POST|DELETE", "path": "/admin/courses/:id/instructors*", "access": "admin", "success": "tugas/lepas pengampu" },
    { "id": "admin.grant", "method": "POST", "path": "/admin/courses/:id/grants", "access": "admin", "success": "201 manual + audit; larang diri sendiri" },
    { "id": "admin.revoke", "method": "POST", "path": "/admin/courses/:id/grants/:userId/revoke", "access": "admin", "success": "200 cancelled + audit" },
    { "id": "invite.admin", "method": "POST|GET|...", "path": "/admin/invitations*", "access": "admin", "success": "buat token 1x pakai 7 hari; revoke/reissue" },
    { "id": "invite.validate", "method": "GET", "path": "/invitations/validate?token=", "access": "public", "success": "200 / 404 / 410" },
    { "id": "invite.accept", "method": "POST", "path": "/invitations/accept", "access": "public", "success": "201 akun teacher + sesi" },
    { "id": "apply.public", "method": "POST", "path": "/instructor-applications", "access": "public", "success": "201 submitted (rate-limit)" },
    { "id": "apply.admin", "method": "GET|PATCH|DELETE|POST-invite", "path": "/admin/instructor-applications*", "access": "admin", "success": "review + invite atomik" }
  ]
}
