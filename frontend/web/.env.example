# ARISTOTELES Frontend (SvelteKit) — contoh env
# Salin ke .env untuk lokal, atau isi via dashboard hosting (Vercel) saat deployment.
# Nanti saat deployment tinggal ganti nilainya saja, tanpa ubah kode.
#
# Aturan SvelteKit: semua yang terbaca browser WAJIB prefix PUBLIC_.
# BACKEND_URL hanya dipakai server (proxy +server.ts), tidak bocor ke browser.

# Base URL backend Express (dipakai browser + CSP + fallback proxy).
# Format: origin + /api/v1, tanpa trailing slash.
# Lokal: http://localhost:3000/api/v1
# Prod contoh: https://api.domain-anda.id/api/v1
PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Kanonis situs untuk SEO/canonical/OG/sitemap (opsional).
# Kosong = ikut origin request, fallback https://aristoteles.id.
# Lokal: http://localhost:5173
# Prod contoh: https://domain-anda.id
PUBLIC_SITE_URL=http://localhost:5173

# Batas waktu request login (ms). Default kode 15000 bila kosong/invalid.
PUBLIC_LOGIN_TIMEOUT_MS=15000

# Base internal backend untuk proxy server
# (src/routes/api/assignments/upload, grade/[id], payments/proof).
# Format: origin SAJA tanpa /api/v1 (kode menormalisasi bila terlanjur ada).
# Kosong = diturunkan otomatis dari PUBLIC_API_BASE_URL.
# Lokal: http://localhost:3000
# Prod contoh: https://api.domain-anda.id
BACKEND_URL=http://localhost:3000
